# Получи токен у @BotFather и вставь его в файл .env на своём компьютере.
TELEGRAM_BOT_TOKEN=

# Здесь хранятся ответы пользователей. Путь считается от папки проекта.
DATABASE_PATH=data/profiles.sqlite3

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Максимум уточняющих вопросов после первого рассказа о себе.
MAX_FOLLOWUP_QUESTIONS=5

